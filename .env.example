# ---- Required ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional direct connection for Drizzle migrations when DATABASE_URL uses a pooler
DATABASE_URL_UNPOOLED=
# ---- Strongly recommended for production ----
# Required for organiser password login. Use a unique, long random value.
ADMIN_PASSWORD=trysth
# Public URL used for sitemap, robots and social cards
SITE_URL=https://your-club.example.com
# Set to "false" to skip demo users, events, posts, groups and profiles on first boot
SEED_DEMO_DATA=false

# ---- Optional ----
# Upgrade AI tutors from the built-in engine to an LLM (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Display timezone for event times
CLUB_TIMEZONE=Europe/London
# Database tuning
DB_POOL_MAX=1
DB_STATEMENT_TIMEOUT_MS=15000
# Set to 1 ONLY if serving over plain HTTP (disables Secure cookies)
COOKIE_INSECURE=
# Who may embed the site in an iframe (CSP frame-ancestors). Defaults to same-origin only.
FRAME_ANCESTORS="'self'"
